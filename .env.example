NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by admin jobs and the SMS auth hook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS OTP delivery (used by /api/sms-hook, the Supabase "Send SMS" auth hook)
# Secret shown in Supabase Dashboard > Authentication > Hooks (format: v1,whsec_...)
SEND_SMS_HOOK_SECRET=v1,whsec_your-secret
# Gateway API key (Alpha SMS / sms.net.bd). Leave empty in local dev to log codes to the console.
SMS_API_KEY=
