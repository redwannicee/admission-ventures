# Frontend (Cloudflare Pages -> Settings -> Environment variables). Public values only.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Edge Function secrets are NOT set here. Set them with:
#   supabase secrets set --env-file supabase/functions/.env.secrets   (file never committed)
# See docs/ENVIRONMENT.md for the full list.
